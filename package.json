{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "audit:routes": "node ./scripts/audit-routes.mjs",
    "verify-rules": "node ./scripts/verify-rules.js",
    "migrate:data": "node ./scripts/migrate-firebase-data.js",
    "sync:github": "bash ./scripts/sync-github.sh"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@imgly/background-removal": "^1.7.0",
    "@paypal/react-paypal-js": "^10.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "browser-image-compression": "^2.0.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "html-to-image": "^1.11.13",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "papaparse": "^5.6.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-dropzone": "^19.1.1",
    "react-player": "^3.4.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "sirv-cli": "^3.0.1",
    "vite": "^6.2.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "puppeteer": "^25.10.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
